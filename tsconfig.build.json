{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "noEmit": false,
    "rootDir": "${configDir}/src",
    "outDir": "${configDir}/dist",
    "rewriteRelativeImportExtensions": true
  },
  "include": ["${configDir}/src"],
  "exclude": [
    "${configDir}/src/**/*.test.ts",
    "${configDir}/src/**/*.bench.ts",
    "${configDir}/src/test-*.ts"
  ]
}
