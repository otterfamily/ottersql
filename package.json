{
  "name": "ottersql-workspace",
  "private": true,
  "type": "module",
  "scripts": {
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "lint": "oxlint",
    "knip": "knip",
    "typecheck": "pnpm -r --no-bail typecheck",
    "build": "pnpm -r build",
    "test": "pnpm -r --no-bail --workspace-concurrency=1 test",
    "test:postgres": "pnpm -r --no-bail --workspace-concurrency=1 test:postgres",
    "verify": "pnpm format:check && pnpm lint && pnpm knip && pnpm typecheck && pnpm test",
    "postinstall": "simple-git-hooks",
    "release": "node packages/release/src/cli.ts bump"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint-plugin-regexp": "catalog:",
    "knip": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "simple-git-hooks": "catalog:",
    "typescript": "catalog:"
  },
  "simple-git-hooks": {
    "pre-push": "pnpm verify"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "12.15.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "26.13.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.15.0"
}
