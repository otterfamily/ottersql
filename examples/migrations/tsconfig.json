{
  "compilerOptions": {
    "target": "es2025",
    "module": "nodenext",
    "lib": ["esnext"],
    "strict": true,
    "noEmit": true,
    "types": ["node"],
    "allowImportingTsExtensions": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "skipLibCheck": true
  },
  "include": ["."]
}
