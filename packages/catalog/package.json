{
  "name": "@ottersql/catalog",
  "version": "0.1.1",
  "description": "Reads a Postgres schema into ottersql's catalog model",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterfamily/ottersql.git",
    "directory": "packages/catalog"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#snapshot-child": "./src/snapshot-child.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "imports": {
      "#snapshot-child": "./dist/snapshot-child.js"
    },
    "exports": {
      ".": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:postgres": "vitest run postgres.test",
    "bench": "vitest bench"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@ottersql/sql": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite-pgvector": "catalog:",
    "@ottersql/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite-pgvector": "catalog:"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite-pgvector": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
