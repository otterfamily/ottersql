{
  "name": "@ottersql/sql",
  "version": "0.1.1",
  "description": "Typed SQL at runtime: reads .sql query files and decodes values with ottersql's codecs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterfamily/ottersql.git",
    "directory": "packages/sql"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#query": "./src/query.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./pg": "./src/pg.ts",
    "./pglite": "./src/pglite.ts",
    "./register": "./src/register.ts",
    "./tooling": "./src/tooling.ts",
    "./vite": "./src/vite.ts"
  },
  "publishConfig": {
    "imports": {
      "#query": "./dist/query.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./pg": "./dist/pg.js",
      "./pglite": "./dist/pglite.js",
      "./register": "./dist/register.js",
      "./tooling": "./dist/tooling.js",
      "./vite": "./dist/vite.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:postgres": "vitest run postgres.test",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@ottersql/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
