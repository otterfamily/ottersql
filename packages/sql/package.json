{
  "name": "@ottersql/sql",
  "version": "0.0.0",
  "private": true,
  "description": "Typed SQL at runtime: reads .sql query files and decodes values with ottersql's codecs",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pg": "./src/pg.ts",
    "./pglite": "./src/pglite.ts",
    "./register": "./src/register.ts",
    "./tooling": "./src/tooling.ts"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:postgres": "vitest run postgres.test",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@ottersql/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5",
    "pg": ">=8"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  }
}
