{
  "name": "@ottersql/sql",
  "version": "0.1.1",
  "description": "Typed SQL at runtime: reads .sql query files and decodes values with ottersql's codecs",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterfamily/ottersql.git",
    "directory": "packages/sql"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "imports": {
    "#query": "./src/query.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./bun-sql": "./src/bun-sql.ts",
    "./esbuild": "./src/esbuild.ts",
    "./pg": "./src/pg.ts",
    "./pg-promise": "./src/pg-promise.ts",
    "./pglite": "./src/pglite.ts",
    "./postgres": "./src/postgres.ts",
    "./register": {
      "bun": "./src/register-bun.ts",
      "default": "./src/register.ts"
    },
    "./tooling": "./src/tooling.ts",
    "./vite": "./src/vite.ts",
    "./webpack": "./src/webpack.ts"
  },
  "publishConfig": {
    "imports": {
      "#query": "./dist/query.js"
    },
    "exports": {
      ".": "./dist/index.js",
      "./bun-sql": "./dist/bun-sql.js",
      "./esbuild": "./dist/esbuild.js",
      "./pg": "./dist/pg.js",
      "./pg-promise": "./dist/pg-promise.js",
      "./pglite": "./dist/pglite.js",
      "./postgres": "./dist/postgres.js",
      "./register": {
        "bun": "./dist/register-bun.js",
        "default": "./dist/register.js"
      },
      "./tooling": "./dist/tooling.js",
      "./vite": "./dist/vite.js",
      "./webpack": "./dist/webpack.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:postgres": "vitest run postgres.test",
    "bench": "vitest bench"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@ottersql/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "esbuild": "catalog:",
    "next": "catalog:",
    "pg": "catalog:",
    "pg-promise": "catalog:",
    "postgres": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "catalog:"
  },
  "peerDependencies": {
    "@electric-sql/pglite": ">=0.5",
    "pg": ">=8",
    "pg-promise": ">=12",
    "postgres": ">=3.4"
  },
  "peerDependenciesMeta": {
    "@electric-sql/pglite": {
      "optional": true
    },
    "pg": {
      "optional": true
    },
    "pg-promise": {
      "optional": true
    },
    "postgres": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=26"
  }
}
