{
  "name": "ottersql",
  "version": "0.1.1",
  "description": "The ottersql command: generates, checks and applies migrations, with JSON output for agents",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/otterfamily/ottersql.git",
    "directory": "packages/cli"
  },
  "bin": {
    "ottersql": "./src/bin.ts"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "bin": {
      "ottersql": "./dist/bin.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p .",
    "test": "vitest run",
    "test:postgres": "vitest run postgres.test"
  },
  "dependencies": {
    "@ottersql/catalog": "catalog:",
    "@ottersql/content-mapper": "catalog:",
    "@ottersql/migrate": "catalog:",
    "@ottersql/sql": "catalog:",
    "jsonc-parser": "catalog:",
    "pg": "catalog:",
    "std-env": "catalog:"
  },
  "devDependencies": {
    "@ottersql/testing": "catalog:",
    "@types/node": "catalog:",
    "@types/pg": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=26"
  }
}
