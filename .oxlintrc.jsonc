{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "options": {
    "typeAware": true,
    "denyWarnings": true,
    "reportUnusedDisableDirectives": "error",
  },
  // Catalog reading matches Postgres's printed SQL with regular expressions, so they get the
  // strictest checks available, including ones for super-linear backtracking (ReDoS).
  "jsPlugins": ["eslint-plugin-regexp"],
  "plugins": [
    "eslint",
    "typescript",
    "unicorn",
    "oxc",
    "import",
    "node",
    "promise",
    "jsdoc",
    "vitest",
  ],
  // Code is mostly written by agents, so every category is on and only rules that contradict
  // another rule or a deliberate convention are turned off below, each with its reason.
  // `restriction` bans language features wholesale, so its rules are picked one by one.
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "pedantic": "error",
    "perf": "error",
    "style": "error",
  },
  "rules": {
    "regexp/confusing-quantifier": "error",
    "regexp/control-character-escape": "error",
    "regexp/grapheme-string-literal": "error",
    "regexp/hexadecimal-escape": "error",
    "regexp/letter-case": "error",
    "regexp/match-any": "error",
    "regexp/negation": "error",
    "regexp/no-contradiction-with-assertion": "error",
    "regexp/no-control-character": "error",
    "regexp/no-dupe-characters-character-class": "error",
    "regexp/no-dupe-disjunctions": "error",
    "regexp/no-empty-alternative": "error",
    "regexp/no-empty-capturing-group": "error",
    "regexp/no-empty-character-class": "error",
    "regexp/no-empty-group": "error",
    "regexp/no-empty-lookarounds-assertion": "error",
    "regexp/no-empty-string-literal": "error",
    "regexp/no-escape-backspace": "error",
    "regexp/no-extra-lookaround-assertions": "error",
    "regexp/no-invalid-regexp": "error",
    "regexp/no-invisible-character": "error",
    "regexp/no-lazy-ends": "error",
    "regexp/no-legacy-features": "error",
    "regexp/no-misleading-capturing-group": "error",
    "regexp/no-misleading-unicode-character": "error",
    "regexp/no-missing-g-flag": "error",
    "regexp/no-non-standard-flag": "error",
    "regexp/no-obscure-range": "error",
    "regexp/no-octal": "error",
    "regexp/no-optional-assertion": "error",
    "regexp/no-potentially-useless-backreference": "error",
    "regexp/no-standalone-backslash": "error",
    "regexp/no-super-linear-backtracking": "error",
    "regexp/no-super-linear-move": "error",
    "regexp/no-trivially-nested-assertion": "error",
    "regexp/no-trivially-nested-quantifier": "error",
    "regexp/no-unused-capturing-group": "error",
    "regexp/no-useless-assertions": "error",
    "regexp/no-useless-backreference": "error",
    "regexp/no-useless-character-class": "error",
    "regexp/no-useless-dollar-replacements": "error",
    "regexp/no-useless-escape": "error",
    "regexp/no-useless-flag": "error",
    "regexp/no-useless-lazy": "error",
    "regexp/no-useless-non-capturing-group": "error",
    "regexp/no-useless-quantifier": "error",
    "regexp/no-useless-range": "error",
    "regexp/no-useless-set-operand": "error",
    "regexp/no-useless-string-literal": "error",
    "regexp/no-useless-two-nums-quantifier": "error",
    "regexp/no-zero-quantifier": "error",
    "regexp/optimal-lookaround-quantifier": "error",
    "regexp/optimal-quantifier-concatenation": "error",
    "regexp/prefer-character-class": "error",
    "regexp/prefer-d": "error",
    "regexp/prefer-escape-replacement-dollar-char": "error",
    "regexp/prefer-lookaround": "error",
    "regexp/prefer-named-backreference": "error",
    "regexp/prefer-named-capture-group": "error",
    "regexp/prefer-named-replacement": "error",
    "regexp/prefer-plus-quantifier": "error",
    "regexp/prefer-predefined-assertion": "error",
    "regexp/prefer-quantifier": "error",
    "regexp/prefer-question-quantifier": "error",
    "regexp/prefer-range": "error",
    "regexp/prefer-regexp-exec": "error",
    "regexp/prefer-regexp-test": "error",
    "regexp/prefer-result-array-groups": "error",
    "regexp/prefer-set-operation": "error",
    "regexp/prefer-star-quantifier": "error",
    "regexp/prefer-unicode-codepoint-escapes": "error",
    "regexp/prefer-w": "error",
    "regexp/require-unicode-regexp": "error",
    "regexp/require-unicode-sets-regexp": "error",
    "regexp/simplify-set-operations": "error",
    "regexp/sort-alternatives": "error",
    "regexp/sort-character-class-elements": "error",
    "regexp/sort-flags": "error",
    "regexp/strict": "error",
    "regexp/unicode-escape": "error",
    "regexp/unicode-property": "error",
    "regexp/use-ignore-case": "error",
    "no-control-regex": "error",
    "no-misleading-character-class": "error",
    "no-regex-spaces": "error",
    "prefer-regex-literals": "error",
    "no-invalid-regexp": "error",
    "no-useless-backreference": "error",
    "no-empty-character-class": "error",

    "eslint/complexity": "error",
    "eslint/no-alert": "error",
    "eslint/no-bitwise": "error",
    "eslint/no-console": "error",
    "eslint/no-div-regex": "error",
    "eslint/no-empty": "error",
    "eslint/no-empty-function": "error",
    "eslint/no-eq-null": "error",
    "eslint/no-implicit-globals": "error",
    "eslint/no-param-reassign": "error",
    "eslint/no-proto": "error",
    "eslint/no-regex-spaces": "error",
    "eslint/no-sequences": "error",
    "eslint/no-var": "error",
    "eslint/unicode-bom": "error",
    "import/no-amd": "error",
    "import/no-commonjs": "error",
    "import/no-cycle": "error",
    "import/no-default-export": "error",
    "import/no-dynamic-require": "error",
    "import/unambiguous": "error",
    "jsdoc/check-access": "error",
    "jsdoc/empty-tags": "error",
    "node/handle-callback-err": "error",
    "node/no-new-require": "error",
    "node/no-path-concat": "error",
    "node/no-process-env": "error",
    "oxc/bad-bitwise-operator": "error",
    "oxc/no-const-enum": "error",
    "promise/spec-only": "error",
    "typescript/explicit-module-boundary-types": "error",
    "typescript/no-dynamic-delete": "error",
    "typescript/no-empty-object-type": "error",
    "typescript/no-explicit-any": "error",
    "typescript/no-import-type-side-effects": "error",
    "typescript/no-invalid-void-type": "error",
    "typescript/no-namespace": "error",
    "typescript/no-non-null-asserted-nullish-coalescing": "error",
    "typescript/no-non-null-assertion": "error",
    "typescript/no-require-imports": "error",
    "typescript/no-var-requires": "error",
    "typescript/promise-function-async": "error",
    "typescript/use-unknown-in-catch-callback-variable": "error",
    "unicorn/no-abusive-eslint-disable": "error",
    "unicorn/no-anonymous-default-export": "error",
    "unicorn/no-array-for-each": "error",
    "unicorn/no-array-reduce": "error",
    "unicorn/no-length-as-slice-end": "error",
    "unicorn/no-magic-array-flat-depth": "error",
    "unicorn/no-process-exit": "error",
    "unicorn/no-useless-error-capture-stack-trace": "error",
    "unicorn/prefer-modern-math-apis": "error",
    "unicorn/prefer-module": "error",
    "unicorn/prefer-node-protocol": "error",
    "unicorn/prefer-number-properties": "error",

    "eslint/func-style": ["error", "declaration", { "allowArrowFunctions": true }],
    "eslint/one-var": ["error", "never"],
    // Property names may mirror external codes, such as Postgres's one-letter catalog values.
    "eslint/id-length": ["error", { "properties": "never" }],
    // A sentence that wraps onto the next comment line continues in lowercase.
    "eslint/capitalized-comments": ["error", "always", { "ignoreConsecutiveComments": true }],
    // Type-only imports stay separate so they are erased (typescript/no-import-type-side-effects).
    "eslint/no-duplicate-imports": ["error", { "allowSeparateTypeImports": true }],
    // Connections, test hooks, regular expressions (lastIndex) and byte buffers are stateful
    // objects that cannot be readonly.
    "typescript/prefer-readonly-parameter-types": [
      "error",
      {
        "ignoreInferredTypes": true,
        "treatMethodsAsReadonly": true,
        "allow": [
          { "from": "package", "name": "PGlite", "package": "@electric-sql/pglite" },
          { "from": "package", "name": "PGliteInterface", "package": "@electric-sql/pglite" },
          { "from": "package", "name": "Client", "package": "pg" },
          { "from": "package", "name": "Pool", "package": "pg" },
          { "from": "package", "name": "PoolClient", "package": "pg" },
          { "from": "package", "name": "Sql", "package": "postgres" },
          { "from": "package", "name": "TransactionSql", "package": "postgres" },
          { "from": "package", "name": "IDatabase", "package": "pg-promise" },
          { "from": "package", "name": "TestProject", "package": "vitest" },
          { "from": "lib", "name": "RegExp" },
          { "from": "lib", "name": "Uint8Array" },
          { "from": "package", "name": "Buffer", "package": "buffer" },
        ],
      },
    ],
    "import/consistent-type-specifier-style": ["error", "prefer-top-level"],
    "eslint/no-magic-numbers": ["error", { "ignore": [-1, 0, 1], "ignoreArrayIndexes": true }],
    "vitest/consistent-test-it": ["error", { "fn": "test", "withinDescribe": "test" }],

    // Keys follow meaning (name before type, a value's kind before its details), not the alphabet.
    "eslint/sort-keys": "off",
    // oxfmt sorts imports; two sorters would fight.
    "eslint/sort-imports": "off",
    // Named exports only (import/no-default-export), so these two cannot both hold.
    "import/no-named-export": "off",
    "import/prefer-default-export": "off",
    // An export sits at its definition so each declaration reads in one place.
    "import/group-exports": "off",
    "import/exports-last": "off",
    // Node.js is a supported runtime; Bun and Deno provide the same node: modules.
    "import/no-nodejs-modules": "off",
    // SQL NULL is part of the model (ADR 0002); undefined would hide it.
    "unicorn/no-null": "off",
    // A single conditional expression is clearer than a statement; nested ones stay banned.
    "eslint/no-ternary": "off",
    // Types document parameters and results; doc comments state only what types cannot.
    "jsdoc/require-param": "off",
    "jsdoc/require-returns": "off",
    // Tests import from vitest explicitly instead of relying on globals.
    "vitest/no-importing-vitest-globals": "off",
    // Vitest 5 already fails tests with unawaited assertions.
    "vitest/prefer-expect-assertions": "off",
    // Module-level setup is how a program starts; the rule is meant for test files (see overrides),
    // and oxlint applies an override's plugins to every file.
    "vitest/require-hook": "off",
    // Round trips on one database connection must run in order; awaiting them in parallel would
    // interleave their protocol messages.
    "eslint/no-await-in-loop": "off",
    // describe titles name concepts, not functions.
    "vitest/prefer-describe-function-title": "off",
    // typescript/require-await covers this with types and allows async functions that only return
    // a promise, which typescript/promise-function-async requires.
    "eslint/require-await": "off",
  },
  "overrides": [
    {
      "files": ["packages/ottersql/src/sql/**"],
      // ADR 0013: the runtime and the driver interface are the base every layer builds on.
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/catalog/**", "**/content-mapper/**", "**/migrate/**", "**/cli/**"],
                "message": "A layer imports only the layers below it (ADR 0006, ADR 0013).",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["packages/ottersql/src/catalog/**"],
      // ADR 0013: the catalog sits on the runtime only.
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/content-mapper/**", "**/migrate/**", "**/cli/**"],
                "message": "A layer imports only the layers below it (ADR 0006, ADR 0013).",
              },
              {
                "group": [
                  "**/sql/**",
                  "!**/sql/index.ts",
                  "!**/sql/internal.ts",
                  "!**/sql/driver.ts",
                  "!**/sql/pg.ts",
                  "!**/sql/pglite.ts",
                ],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["packages/ottersql/src/content-mapper/**"],
      // ADR 0013: typed SQL sits on the catalog and the runtime.
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/migrate/**", "**/cli/**"],
                "message": "A layer imports only the layers below it (ADR 0006, ADR 0013).",
              },
              {
                "group": [
                  "**/sql/**",
                  "!**/sql/index.ts",
                  "!**/sql/internal.ts",
                  "!**/sql/driver.ts",
                  "!**/sql/pg.ts",
                  "!**/sql/pglite.ts",
                ],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
              {
                "group": ["**/catalog/**", "!**/catalog/index.ts", "!**/catalog/internal.ts"],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["packages/ottersql/src/migrate/**"],
      // ADR 0013: migrations sit on the catalog and the runtime, below the command.
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["**/content-mapper/**", "**/cli/**"],
                "message": "A layer imports only the layers below it (ADR 0006, ADR 0013).",
              },
              {
                "group": [
                  "**/sql/**",
                  "!**/sql/index.ts",
                  "!**/sql/internal.ts",
                  "!**/sql/driver.ts",
                  "!**/sql/pg.ts",
                  "!**/sql/pglite.ts",
                ],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
              {
                "group": ["**/catalog/**", "!**/catalog/index.ts", "!**/catalog/internal.ts"],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["packages/ottersql/src/cli/**"],
      // ADR 0013: the command sits on every layer.
      "rules": {
        "eslint/no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "**/sql/**",
                  "!**/sql/index.ts",
                  "!**/sql/internal.ts",
                  "!**/sql/driver.ts",
                  "!**/sql/pg.ts",
                  "!**/sql/pglite.ts",
                ],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
              {
                "group": ["**/catalog/**", "!**/catalog/index.ts", "!**/catalog/internal.ts"],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
              {
                "group": [
                  "**/content-mapper/**",
                  "!**/content-mapper/index.ts",
                  "!**/content-mapper/internal.ts",
                ],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
              {
                "group": ["**/migrate/**", "!**/migrate/index.ts", "!**/migrate/internal.ts"],
                "message": "Another layer is imported through its index.ts, or internal.ts for what stays inside the package (ADR 0013).",
              },
            ],
          },
        ],
      },
    },
    {
      "files": ["examples/**"],
      // tsgolint does not run TypeScript's content mappers, so what examples import from .sql files
      // is unresolved for these rules; tsc --runExternalCode checks those imports instead.
      "rules": {
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        // Examples print what they do for the reader to see.
        "eslint/no-console": "off",
        // Examples read their database URL from the environment, as applications do.
        "node/no-process-env": "off",
      },
    },
    {
      "files": ["packages/ottersql/src/cli/bin.ts"],
      // The command's entry reads the environment once and passes it in, so that everything else
      // takes it as an argument and tests can give their own.
      "rules": { "node/no-process-env": "off" },
    },
    {
      "files": ["packages/ottersql/src/sql/wait.ts"],
      // The query runtime imports nothing from Node so it runs in browsers with PGlite too, and
      // without node:timers/promises a timer is awaited through a promise made here.
      "rules": { "promise/avoid-new": "off" },
    },
    {
      "files": ["packages/ottersql/src/sql/esbuild.ts"],
      // esbuild reads plugin filters as Go regular expressions, which take no flags.
      "rules": {
        "eslint/require-unicode-regexp": "off",
        "regexp/require-unicode-regexp": "off",
        "regexp/require-unicode-sets-regexp": "off",
      },
    },
    {
      "files": [
        "packages/ottersql/src/sql/webpack.ts",
        "packages/ottersql/src/sql/test-typescript-loader.ts",
      ],
      // webpack takes a loader as a module's default export and calls it with its context as `this`.
      "rules": { "import/no-default-export": "off", "oxc/no-this-in-exported-function": "off" },
    },
    {
      "files": ["packages/ottersql/src/sql/register-bun.ts"],
      // Bun asks the plugin for a module synchronously when a .sql file is loaded through require.
      "rules": { "node/no-sync": "off" },
    },
    {
      "files": ["packages/testing/src/global-setup.ts"],
      // CI picks the Postgres major of a run through the environment, before any test starts.
      "rules": { "node/no-process-env": "off" },
    },
    {
      "files": ["**/*.bench.ts"],
      // A benchmark measures; it has nothing to assert.
      "rules": { "vitest/expect-expect": "off" },
    },
    {
      "files": ["**/vitest.config.ts"],
      // Vitest reads its config from the default export.
      "rules": { "import/no-default-export": "off" },
    },
    {
      // Vitest's rules describe test files; elsewhere a function named `describe` is not a suite.
      "files": ["**/*.test.ts", "**/*.bench.ts"],
      "plugins": ["vitest"],
      "rules": { "vitest/require-hook": "error" },
    },
    {
      "files": ["**/*.test.ts", "**/test-*.ts"],
      // Vitest reads which fixtures a fixture depends on from its first parameter's pattern, so a
      // fixture with none is written `({}, use)`.
      "rules": {
        "eslint/no-empty-pattern": ["error", { "allowObjectPatternsAsParameters": true }],
      },
    },
    {
      "files": ["**/*.test.ts"],
      "rules": {
        // Expected values are literals by design: they come from the spec, not the code.
        "eslint/no-magic-numbers": "off",
        // Tests extended with fixtures (`test.extend`) are still test blocks.
        "vitest/no-standalone-expect": [
          "error",
          { "additionalTestBlockFunctions": ["test", "test.for"] },
        ],
        // A table-driven test is one long list of cases.
        "eslint/max-lines-per-function": "off",
        "eslint/max-statements": "off",
      },
    },
  ],
  // Wrong on purpose, to show how errors are reported.
  "ignorePatterns": ["**/node_modules/**", "**/dist/**", "examples/*/mistakes/**"],
}
